# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Production (Docker/VPS): NODE_ENV=production, CLIENT_URL=https://panel.yourdomain.com
CLIENT_URL=http://localhost:5173
# Production (must match browser URL exactly, https, no trailing slash):
# CLIENT_URL=https://your-site.hostingersite.com
# CORS_EXTRA_ORIGINS=https://www.your-site.com

# Public URL for reset emails (phone / other devices). Never use localhost here.
# LAN (same WiFi): http://YOUR_MAC_IP:5174  — run: ipconfig getifaddr en0
# Production: https://dashboard.yourdomain.com
PUBLIC_APP_URL=

# SMTP — password reset & transactional email (Gmail: App Password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Syntax Verse Hosting <you@gmail.com>"
APP_NAME=Syntax Verse Hosting
# Logo in emails (must be publicly reachable — same as frontend /logo.png)
# APP_LOGO_URL=http://localhost:5173
# APP_LOGO_PATH=/logo.png

# ─── MySQL — Application (API uses these) ─────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=syntaxverse
MYSQL_USER=syntaxverse
MYSQL_PASSWORD=syntaxverse_dev

# ─── MySQL — Admin (only for creating DB + user on first run) ─
# Local Mac/Homebrew: root often has NO password → leave empty
# Docker Compose:    root password is rootpass (see docker-compose.yml)
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=

# Auto-create database + user on API start (set false in production if DBA manages DB)
MYSQL_AUTO_PROVISION=true
# Production Docker: use project root .env — see .env.docker.example

# Max MySQL packet size in bytes (default 67108864 = 64MB). Fixes "packet bigger than max_allowed_packet".
# MYSQL_MAX_ALLOWED_PACKET=67108864

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE=7d

# ─── Admin seed (created on first API start) ──────────────
ADMIN_EMAIL=admin@syntaxverse.com
ADMIN_PASSWORD=Admin123!

# ─── Hosting sites (subdomain preview URLs) ───────────────
SITES_BASE_HOST=sites.localhost
# Hostinger panel on *.hostingersite.com — auto-served from ../public_html (see servePanelSpa.js)
# PANEL_STATIC_DIR=/home/.../domains/yoursite.com/public_html

# SSL — point domain A record to SERVER_PUBLIC_IP, then Install SSL in dashboard
SERVER_PUBLIC_IP=76.76.21.21
SSL_SKIP_DNS_CHECK=true
# Dev only — local HTTPS listener. Production URLs never include this port.
SSL_HTTPS_PORT=5443
SSL_FORCE_HTTPS=true

# Backups — site files + MySQL dumps (requires tar on system)
BACKUP_MAX_PER_USER=10
BACKUP_AUTO_DAILY=false

# File Manager — multipart upload + .zip extract (max per file)
SITE_UPLOAD_MAX_MB=500

# Web Terminal + optional external SSH (PuTTY, Terminal.app, etc.)
# Development: keep 127.0.0.1 and use the in-browser terminal only.
# Production VPS: SSH_HOST=ssh.yourdomain.com, DNS A record, SSH_ENABLED=true
SSH_HOST=127.0.0.1
SSH_PORT=22
# SSH_ENABLED=true
# TERMINAL_TIMEOUT_MS=600000
# TERMINAL_SHELL=/bin/zsh

# phpMyAdmin (Hostinger-style DB manager)
PHPMYADMIN_URL=http://localhost:8080
# From project root: npm run pma:up  (requires Docker Desktop)
# Local API + MySQL on Mac:
PHPMYADMIN_MYSQL_HOST=host.docker.internal
# Full Docker stack (API + MySQL in compose): PHPMYADMIN_MYSQL_HOST=mysql
# PMA_BRIDGE_URL=http://host.docker.internal:5000
